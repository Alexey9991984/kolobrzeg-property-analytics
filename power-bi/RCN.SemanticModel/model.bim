            "sourceColumn": "tran_rodzaj_trans",
            "summarizeBy": "none"
          },
          {
            "name": "Market",
            "dataType": "string",
            "sourceColumn": "tran_rodzaj_rynku",
            "summarizeBy": "none"
          },
          {
            "name": "Seller type",
            "dataType": "string",
            "sourceColumn": "tran_sprzedajacy",
            "summarizeBy": "none"
          },
          {
            "name": "Buyer type",
            "dataType": "string",
