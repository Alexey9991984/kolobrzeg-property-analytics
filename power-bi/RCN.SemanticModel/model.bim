{
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "Transactions",
        "columns": [
          {
            "name": "Transaction ID",
            "dataType": "string",
            "sourceColumn": "ID сделки",
            "summarizeBy": "none"
          },
          {
            "name": "Document date",
            "dataType": "dateTime",
            "sourceColumn": "Дата документа",
            "summarizeBy": "none"
          },
          {
            "name": "Year",
            "dataType": "int64",
            "sourceColumn": "Год",
            "summarizeBy": "none"
          },
          {
            "name": "Address",
            "dataType": "string",
            "sourceColumn": "Адрес",
            "summarizeBy": "none"
          },
          {
            "name": "Locality",
            "dataType": "string",
            "sourceColumn": "Населённый пункт",
            "summarizeBy": "none"
          },
          {
            "name": "Market",
            "dataType": "string",
            "sourceColumn": "Рынок",
            "summarizeBy": "none"
          },
          {
            "name": "Sale type",
            "dataType": "string",
            "sourceColumn": "Вид сделки",
            "summarizeBy": "none"
          },
          {
            "name": "Transaction price (PLN)",
            "dataType": "double",
            "sourceColumn": "Цена сделки, PLN",
            "summarizeBy": "none"
          },
          {
            "name": "Object count",
            "dataType": "int64",
            "sourceColumn": "Объектов",
            "summarizeBy": "none"
          },
          {
            "name": "House candidate (100–150 m²)",
            "dataType": "string",
            "sourceColumn": "Кандидат 100–150 м²",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Сделки",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(\"localhost:5432\", \"kolobrzeg_property_analytics_v2\"),",
                "    Rows = Source{[Schema=\"rcn\", Item=\"report_transactions\"]}[Data],",
                "    Columns = Table.SelectColumns(Rows, {\"ID сделки\",\"Дата документа\",\"Год\",\"Адрес\",\"Населённый пункт\",\"Рынок\",\"Вид сделки\",\"Цена сделки, PLN\",\"Объектов\",\"Кандидат 100–150 м²\"}),",
                "    Labels = [#\"rynek wtórny\" = \"Secondary market\", #\"rynek pierwotny\" = \"Primary market\", #\"wolny rynek\" = \"Open-market sale\", #\"sprzedaż z bonifikatą\" = \"Discounted sale\", #\"sprzedaż przetargowa\" = \"Tender sale\", #\"sprzedaż bezprzetargowa\" = \"Non-tender sale\", #\"sprzedaż w postępowaniu egzekucyjnym\" = \"Enforcement sale\", #\"sprzedaż na cel publiczny\" = \"Sale for public use\", #\"brak danych\" = \"Not recorded\", #\"nie dotyczy\" = \"Not applicable\", #\"Budynki\" = \"Buildings\", #\"Działki\" = \"Land parcels\", #\"Lokale\" = \"Units\", #\"mieszkalny\" = \"Residential\", #\"mieszkalna\" = \"Residential\", #\"niemieszkalna\" = \"Non-residential\", #\"pozostaleNiemieszkalne\" = \"Other non-residential\", #\"handlowoUslugowy\" = \"Retail and services\", #\"transportuILacznosci\" = \"Transport and communications\", #\"szpitale\" = \"Hospitals\", #\"gospodarczy\" = \"Utility building\", #\"przemyslowy\" = \"Industrial\", #\"biurowy\" = \"Office\", #\"zbiornikiSilosyMagazyny\" = \"Tanks, silos and warehouses\", #\"nieruchomość lokalowa\" = \"Unit property\", #\"nieruchomość gruntowa zabudowana\" = \"Developed land\", #\"nieruchomość gruntowa niezabudowana\" = \"Undeveloped land\", #\"nieruchomość budynkowa\" = \"Building property\", #\"osoba fizyczna\" = \"Individual\", #\"osoba prawna\" = \"Legal entity\", #\"własność nieruchomości gruntowej\" = \"Freehold land ownership\", #\"własność lokalu z prawem związanym\" = \"Unit ownership with associated right\", #\"własność budynku z prawem związanym\" = \"Building ownership with associated right\", #\"użytkowanie wieczyste\" = \"Perpetual usufruct\", #\"Да\" = \"Yes\", #\"Нет\" = \"No\"],",
                "    Translate = (value as nullable text) as nullable text => if value = null then null else Record.FieldOrDefault(Labels, value, value),",
                "    English = Table.TransformColumns(Columns, {{\"Рынок\", Translate, type nullable text}, {\"Вид сделки\", Translate, type nullable text}, {\"Кандидат 100–150 м²\", Translate, type nullable text}})",
                "in English"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Transaction count",
            "expression": "COUNTROWS('Transactions')",
            "formatString": "#,0"
          },
          {
            "name": "Median transaction price",
            "expression": "MEDIAN('Transactions'[Transaction price (PLN)])",
            "formatString": "#,0 \"zł\""
          }
        ]
      },
      {
        "name": "Objects",
        "columns": [
          {
            "name": "Transaction reference",
            "dataType": "string",
            "sourceColumn": "tran_oznaczenie_trans",
            "summarizeBy": "none"
          },
          {
            "name": "Transaction ID",
            "dataType": "string",
